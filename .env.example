# Copy to .env.local (local) and add the same variables in Vercel → Project → Settings → Environment Variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ENQUIRY_IP_SALT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Password of the Titan mailbox hello@urbanbeetle.com (sends the client's confirmation email)
SMTP_PASSWORD=
# Cloudflare Turnstile (security check under the enquiry form): dash.cloudflare.com → Turnstile → your widget.
# The check is on only when both are set. Mark the secret key as sensitive on Vercel.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: when set on Vercel, only Vercel's scheduler can call /api/keepalive (any random 16+ characters).
CRON_SECRET=
# Only needed locally, for npm run whatsapp:template / whatsapp:status
WHATSAPP_BUSINESS_ACCOUNT_ID=
